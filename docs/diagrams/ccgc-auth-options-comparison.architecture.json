  "cards": [
    {
      "dot": "emerald",
      "title": "Option A — Pros",
      "items": [
        "One user-facing control plane: LiteLLM UI",
        "No enterprise JWT license dependency",
        "Native key rotation, revocation, budgets, rates, spend, teams, and models"
      ]
    },
    {
      "dot": "rose",
      "title": "Option A — Tradeoffs",
      "items": [
        "Users must securely receive and store a virtual key",
        "LiteLLM API-key identity replaces Entra identity on inference requests",
        "GitHub must be connected by the same LiteLLM user who owns the key"
      ]
    },
    {
      "dot": "amber",
      "title": "Option B — Migration-only Cost",
      "items": [
        "Preserves existing enrollment and rollback during migration",
        "Adds broker, admission, database, Key Vault, and custom-auth lifecycle",
        "Retire after direct-key isolation, rotation, revocation, and client tests pass"
      ]
    }
  ]
