  "cards": [
    {
      "dot": "amber",
      "title": "Option A — Pros / Cons",
      "items": [
        "PRO — Fewer components and lower operational complexity.",
        "PRO — Native LiteLLM dashboard sign-in and GitHub-link flow.",
        "CON — No independent Entra ↔ expected-GitHub identity binding.",
        "CON — Direct credential distribution; offboarding, audit, revocation, and bounded access are separate."
      ]
    },
    {
      "dot": "emerald",
      "title": "Option B — Pros",
      "items": [
        "PRO — Entra checks plus expected GitHub login and immutable account-ID binding.",
        "PRO — Controlled enrollment, bounded admission, coordinated revocation, and joined audit.",
        "PRO — Approved-model policy while LiteLLM retains native github_copilot + per_user_oauth.",
        "PRO — Recommended now for enterprise identity and policy controls."
      ]
    },
    {
      "dot": "amber",
      "title": "Option B — Costs / Cons & Migration",
      "items": [
        "CON — Added control-plane complexity and another service/database policy layer.",
        "CON — Custom admission and identity integration require maintenance.",
        "PRO — Strict Entra JWT mapping may later remove only the credential bridge.",
        "CON — Simplify only after RC maturity and parity for clients, bounded access, revocation, audit, and identity binding."
      ]
    }
  ]
