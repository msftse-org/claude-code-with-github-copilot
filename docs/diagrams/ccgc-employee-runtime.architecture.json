  "cards": [
    {
      "dot": "cyan",
      "title": "What LiteLLM does",
      "items": [
        "Receives Claude Code's native Anthropic Messages API.",
        "Maps the bounded employee credential to that employee's LiteLLM virtual key and encrypted GitHub OAuth connection.",
        "Uses LiteLLM's built-in GitHub Copilot provider to call GitHub Copilot's HTTPS /v1/messages API and stream the response back."
      ]
    },
    {
      "dot": "emerald",
      "title": "API integration, not an SDK",
      "items": [
        "GitHub Copilot supplies the employee-specific model entitlement.",
        "There is no GitHub SDK in the request path, no direct Anthropic API key, and no shared Copilot seat."
      ]
    }
  ]
