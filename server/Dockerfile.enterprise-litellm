FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS litellm-source

ADD "https://github.com/BerriAI/litellm/archive/464a4dba9dc1dadf6d7affaa985aa7050596a745.tar.gz" /tmp/litellm.tar.gz
RUN echo "1dda51709d79bcaf082a15f56dc088ff70bb578f2a289f4f64c7f4c5031def22  /tmp/litellm.tar.gz" \
      | sha256sum -c - \
    && mkdir /src \
    && tar -xzf /tmp/litellm.tar.gz --strip-components=1 -C /src

FROM python:3.13.11-slim@sha256:2b9c9803c6a287cafa0a8c917211dddd23dcd2016f049690ee5219f5d3f1636e AS ccgc-wheels

RUN mkdir /wheels \
    && pip download --index-url https://packagefeedproxy.microsoft.io/pypi/simple/ \
      --only-binary=:all: --dest /wheels \
      "asyncpg==0.30.0" \
      "azure-identity==1.25.1" \
      "azure-keyvault-secrets==4.10.0" \
      "PyJWT[crypto]==2.10.1"

FROM ghcr.io/berriai/litellm:main-latest@sha256:de5b050c1e9bd7e6c0aebfa126c5df71de071962592ba3e9638b28e45bed3901

COPY --from=litellm-source /src/litellm /app/.venv/lib/python3.13/site-packages/litellm
COPY --from=litellm-source /src/litellm-proxy-extras/litellm_proxy_extras /app/.venv/lib/python3.13/site-packages/litellm_proxy_extras
COPY --from=litellm-source /src/litellm-proxy-extras/litellm_proxy_extras /app/litellm-proxy-extras/litellm_proxy_extras
COPY --from=litellm-source /src/litellm-proxy-extras/litellm_proxy_extras/schema.prisma /app/schema.prisma
COPY --from=ccgc-wheels /wheels /tmp/ccgc-wheels

RUN /app/.venv/bin/python -m ensurepip \
    && /app/.venv/bin/python -m pip install --no-cache-dir --no-index --find-links=/tmp/ccgc-wheels \
      "asyncpg==0.30.0" \
      "azure-identity==1.25.1" \
      "azure-keyvault-secrets==4.10.0" \
      "PyJWT[crypto]==2.10.1" \
    && rm -rf /tmp/ccgc-wheels

RUN DATABASE_URL=postgresql://generate:generate@localhost:5432/generate \
    /app/.venv/bin/prisma generate --schema /app/schema.prisma

COPY server/litellm.enterprise.yaml /app/config.yaml
COPY server/ccgc_litellm_auth.py /app/ccgc_litellm_auth.py
COPY server/litellm-github-copilot-bootstrap/api-key.json /root/.config/litellm/github_copilot/api-key.json

CMD ["--config", "/app/config.yaml", "--host", "0.0.0.0", "--port", "4000"]
